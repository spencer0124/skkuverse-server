{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.{js,ts}",
    "src/main.ts",
    "scripts/**/*.js",
    "__tests__/**/*.test.{js,ts}"
  ],
  "project": ["**/*.{js,ts}"],
  "ignoreDependencies": ["@logtail/pino", "pino-pretty"],
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off"
  }
}
