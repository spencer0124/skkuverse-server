{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "ko",
        "en"
      ]
    },
    "bullets": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "language",
    "bullets",
    "version"
  ]
}
