{
  "name": "skkuverse-server",
  "version": "3.5.1-260531",
  "description": "",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "prestart": "npm run build",
    "dev": "npm run build && NODE_ENV=development npm run dev:watch",
    "dev:prod-api": "npm run build && NODE_ENV=development USE_PROD_API=true npm run dev:watch",
    "dev:watch": "concurrently -k \"tsc --watch --preserveWatchOutput\" \"nodemon --watch dist dist/src/main.js\"",
    "build": "tsc && node scripts/copy-build-assets.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "lint": "eslint . && npm run lint:md",
    "lint:md": "markdownlint-cli2",
    "knip": "knip",
    "depcheck": "depcheck --ignores='@logtail/pino,pino-pretty,node-cron,nodemon,@types/node,@types/jest,@types/express,@types/supertest,@typescript-eslint/eslint-plugin,@typescript-eslint/parser'",
    "verify:serve": "docker compose -f docker-compose.yml -f docker-compose.local-verify.yml up -d --build",
    "verify:serve:down": "docker compose -f docker-compose.yml -f docker-compose.local-verify.yml down"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@logtail/pino": "0.5.8",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/schedule": "6.1.3",
    "axios": "1.13.6",
    "date-holidays": "3.30.2",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "firebase-admin": "13.10.0",
    "helmet": "8.2.0",
    "moment": "2.30.1",
    "moment-timezone": "0.6.2",
    "mongodb": "7.2.0",
    "mongoose": "9.6.3",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.1.24",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "concurrently": "9.2.1",
    "depcheck": "1.4.7",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "knip": "6.14.2",
    "markdownlint-cli2": "^0.23.1",
    "node-cron": "4.2.1",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  }
}
