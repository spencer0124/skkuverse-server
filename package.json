{
  "name": "skkuverse-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "prestart": "npm run build",
    "dev": "npm run build && NODE_ENV=development npm run dev:watch",
    "dev:prod-api": "npm run build && NODE_ENV=development USE_PROD_API=true npm run dev:watch",
    "dev:watch": "concurrently -k \"tsc --watch --preserveWatchOutput\" \"nodemon --watch dist dist/index.js\"",
    "build": "tsc && node scripts/copy-build-assets.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "swagger": "npm run build && node swagger/swagger.js",
    "lint": "eslint .",
    "knip": "knip",
    "depcheck": "depcheck --ignores='@logtail/pino,pino-pretty,node-cron,nodemon,@types/node,@types/jest,@types/express,@types/supertest,@types/swagger-ui-express,@typescript-eslint/eslint-plugin,@typescript-eslint/parser'"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@logtail/pino": "0.5.8",
    "axios": "1.13.6",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "firebase-admin": "13.10.0",
    "helmet": "8.2.0",
    "moment": "2.30.1",
    "moment-timezone": "0.6.2",
    "mongodb": "7.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/supertest": "7.2.0",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "concurrently": "9.2.1",
    "depcheck": "1.4.7",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "knip": "6.14.2",
    "node-cron": "4.2.1",
    "nodemon": "3.1.14",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "swagger-autogen": "2.23.7",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  }
}
